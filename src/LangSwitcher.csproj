<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LangSwitcher</AssemblyName>
    <RootNamespace>LangSwitcher</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>LangSwitcher</Product>
    <Version>1.0.1</Version>
    <Company>Eugene Vitko</Company>
    <Authors>Eugene Vitko</Authors>
    <Copyright>© 2026 Eugene Vitko</Copyright>
    <AssemblyTitle>LangSwitcher — автопереключатель раскладки En/Ru</AssemblyTitle>
    <Description>Автопереключатель раскладки En/Ru для Windows</Description>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
